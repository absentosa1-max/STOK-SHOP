rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permit read and write operations on application collections
    match /users/{userId} {
      allow read, write: if true;
    }

    match /products/{productId} {
      allow read, write: if true;
    }

    match /logs/{logId} {
      allow read, write: if true;
    }

    match /incomingRecords/{recordId} {
      allow read, write: if true;
    }

    match /outgoingRecords/{recordId} {
      allow read, write: if true;
    }

    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
